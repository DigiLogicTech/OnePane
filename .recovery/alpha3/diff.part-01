+func (s *Server) listRuntimeQueue(w http.ResponseWriter, r *http.Request) {
+	i, ok := s.authenticate(w, r)
+	if !ok {
+		return
+	}
+	workspaceID := strings.TrimSpace(r.URL.Query().Get("workspace_id"))
+	if workspaceID == "" {
+		writeError(w, http.StatusBadRequest, "workspace_id is required")
+		return
+	}
+	if !s.authorize(w, r, i, workspaceID, "models.read") {
+		return
+	}
+	if s.runtimeCoord == nil {
+		writeError(w, http.StatusServiceUnavailable, "runtime coordinator unavailable")
+		return
+	}
+	rows, err := s.runtimeCoord.Snapshot(r.Context(), 200)
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, err.Error())
+		return
+	}
+	filtered := rows[:0]
+	for _, row := range rows {
+		if row.WorkspaceID == workspaceID {
+			filtered = append(filtered, row)
+		}
+	}
+	writeJSON(w, http.StatusOK, filtered)
+}
+
