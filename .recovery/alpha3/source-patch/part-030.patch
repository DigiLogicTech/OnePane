+					cand.Schedulable = false
+				}
+			} else if err != sql.ErrNoRows {
+				return nil, err
+			}
+		}
 		out = append(out, cand)
 	}
 	return out, rows.Err()
 }
 
+func firstNonBlank(values ...string) string {
+	for _, value := range values {
+		if strings.TrimSpace(value) != "" {
+			return strings.TrimSpace(value)
+		}
+	}
+	return ""
+}
