@@ -641,0 +726,190 @@ func (s *Server) getProject(w http.ResponseWriter, r *http.Request) {
+func (s *Server) projectForWorkspaceView(ctx context.Context, workspaceID string) (projectworkspace.WorkspaceView, projectworkspace.Project, error) {
+	view, err := s.projects.WorkspaceView(ctx, workspaceID)
+	if err != nil {
+		return view, projectworkspace.Project{}, err
+	}
+	p, err := s.projects.Project(ctx, view.ProjectID)
+	return view, p, err
+}
+
+func (s *Server) listProjectWorkspaces(w http.ResponseWriter, r *http.Request) {
+	i, ok := s.authenticate(w, r)
+	if !ok {
+		return
+	}
+	p, err := s.projects.Project(r.Context(), strings.TrimSpace(r.PathValue("projectID")))
+	if err != nil {
+		respondDomain(w, nil, err, 0)
+		return
+	}
+	if !s.authorize(w, r, i, p.WorkspaceID, "projects.read") {
+		return
+	}
+	xs, err := s.projects.WorkspaceViews(r.Context(), p.ID)
+	respondDomain(w, map[string]any{"workspaces": xs}, err, http.StatusOK)
+}
+func (s *Server) createProjectWorkspace(w http.ResponseWriter, r *http.Request) {
+	i, ok := s.authenticate(w, r)
+	if !ok {
+		return
+	}
+	p, err := s.projects.Project(r.Context(), strings.TrimSpace(r.PathValue("projectID")))
+	if err != nil {
+		respondDomain(w, nil, err, 0)
+		return
+	}
+	if !s.authorize(w, r, i, p.WorkspaceID, "projects.write") {
+		return
+	}
+	var in struct {
+		Name          string          `json:"name"`
+		Description   *string         `json:"description"`
+		Layout        json.RawMessage `json:"layout"`
+		AISettings    json.RawMessage `json:"ai_settings"`
+		ResourceScope json.RawMessage `json:"resource_scope"`
+		State         json.RawMessage `json:"state"`
+		StorageRoot   *string         `json:"storage_root"`
+	}
+	if !decodeJSON(w, r, &in) {
+		return
+	}
+	x, err := s.projects.CreateWorkspaceView(r.Context(), projectworkspace.CreateWorkspaceViewCommand{ProjectID: p.ID, Name: in.Name, Description: in.Description, LayoutJSON: in.Layout, AISettingsJSON: in.AISettings, ResourceScopeJSON: in.ResourceScope, StateJSON: in.State, StorageRoot: in.StorageRoot, ActorPrincipalID: i.PrincipalID})
+	respondDomain(w, x, err, http.StatusCreated)
+}
+func (s *Server) getProjectWorkspace(w http.ResponseWriter, r *http.Request) {
+	i, ok := s.authenticate(w, r)
+	if !ok {
+		return
+	}
+	x, p, err := s.projectForWorkspaceView(r.Context(), strings.TrimSpace(r.PathValue("workspaceID")))
+	if err != nil {
+		respondDomain(w, nil, err, 0)
+		return
+	}
+	if !s.authorize(w, r, i, p.WorkspaceID, "projects.read") {
+		return
+	}
+	writeJSON(w, http.StatusOK, x)
+}
