+func (s *Server) listGlobalResourceLeases(w http.ResponseWriter, r *http.Request) {
+	i, ok := s.authenticate(w, r)
+	if !ok {
+		return
+	}
+	workspaceID := strings.TrimSpace(r.URL.Query().Get("workspace_id"))
+	if workspaceID == "" || !s.authorize(w, r, i, workspaceID, "projects.read") {
+		return
+	}
+	if s.resourceCoord == nil {
+		writeJSON(w, http.StatusOK, map[string]any{"leases": []any{}})
+		return
+	}
+	rows, err := s.resourceCoord.Snapshot(r.Context(), 200)
+	respondDomain(w, map[string]any{"leases": rows}, err, http.StatusOK)
+}
