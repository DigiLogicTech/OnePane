--- a/packaging/windows/setup/main.go
+++ b/packaging/windows/setup/main.go
@@ -491,6 +491,7 @@ func uninstallProduct() error {
 	if programData == "" {
 		programData = `C:\\ProgramData`
 	}
+	logf("starting resilient uninstall; durable data will be preserved")
 	dataDir := filepath.Join(programData, "OnePane")
 	installDir := readInstallPath(dataDir)
 	if installDir == "" {
@@ -499,6 +500,27 @@ func uninstallProduct() error {
 	_ = runHidden("taskkill.exe", "/IM", "OnePane.Desktop.exe", "/F")
+	_ = runHidden("taskkill.exe", "/IM", "OnePane.Backend.exe", "/F")
 	_ = runHidden("sc.exe", "stop", serviceName)
+	// A broken/already-stopped service (1060/1062) is an idempotent uninstall
+	// condition. Continue teardown instead of making service health a prerequisite.
+	time.Sleep(1200 * time.Millisecond)
+	_ = runHidden("taskkill.exe", "/IM", "OnePane.Service.exe", "/F")
 	_ = runHidden("sc.exe", "delete", serviceName)
+	// Never recursively remove ProgramData, configured Project storage, or the
+	// model pool here. They are durable user state and survive normal uninstall.
+	// The setup executable is running from installDir, so let a detached process
+	// remove application files after this process exits.
+	if strings.TrimSpace(installDir) != "" {
+		quoted := strings.ReplaceAll(installDir, "'", "''")
+		script := `$p=` + fmt.Sprint(os.Getpid()) + `; ` +
+			`try { Wait-Process -Id $p -Timeout 30 -ErrorAction SilentlyContinue } catch {}; ` +
+			`Start-Sleep -Milliseconds 400; ` +
+			`Remove-Item -LiteralPath '` + quoted + `' -Recurse -Force -ErrorAction SilentlyContinue`
+		cmd := exec.Command("powershell.exe", "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden", "-Command", script)
+		cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true, CreationFlags: 0x00000008}
+		if err := cmd.Start(); err != nil {
+			return fmt.Errorf("schedule application cleanup: %w", err)
+		}
+	}
 	return nil
 }
