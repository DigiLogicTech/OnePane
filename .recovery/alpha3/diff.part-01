+func (s *Server) getNodeComputePolicy(w http.ResponseWriter, r *http.Request) {
+	if _, ok := s.requireNodeOperator(w, r); !ok {
+		return
+	}
+	nodeID := strings.TrimSpace(r.PathValue("nodeID"))
+	p, err := s.federation.ComputePolicy(r.Context(), nodeID)
+	if errors.Is(err, sql.ErrNoRows) {
+		writeJSON(w, http.StatusOK, map[string]any{"node_id": nodeID, "enabled": true, "idle_only": false, "allow_model_downloads": true, "runtime_installation": "confirm", "project_scope": "all", "availability": map[string]any{}, "limits": map[string]any{}, "allowed_projects": []string{}})
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusInternalServerError, err.Error())
+		return
+	}
+	writeJSON(w, http.StatusOK, p)
+}
+
+func (s *Server) setNodeComputePolicy(w http.ResponseWriter, r *http.Request) {
+	i, ok := s.requireNodeOperator(w, r)
+	if !ok {
+		return
+	}
+	var in struct {
+		Enabled             bool            `json:"enabled"`
+		IdleOnly            bool            `json:"idle_only"`
+		Availability        json.RawMessage `json:"availability"`
+		Limits              json.RawMessage `json:"limits"`
+		AllowModelDownloads bool            `json:"allow_model_downloads"`
+		RuntimeInstallation string          `json:"runtime_installation"`
+		ProjectScope        string          `json:"project_scope"`
+		AllowedProjects     json.RawMessage `json:"allowed_projects"`
+	}
+	if !decodeJSON(w, r, &in) {
+		return
+	}
+	p, err := s.federation.SetComputePolicy(r.Context(), nodefederation.SetComputePolicyCommand{NodeID: strings.TrimSpace(r.PathValue("nodeID")), Enabled: in.Enabled, IdleOnly: in.IdleOnly, AvailabilityJSON: in.Availability, LimitsJSON: in.Limits, AllowModelDownloads: in.AllowModelDownloads, RuntimeInstallation: in.RuntimeInstallation, ProjectScope: in.ProjectScope, AllowedProjectsJSON: in.AllowedProjects, Actor: i.PrincipalID})
+	if err != nil {
+		writeError(w, http.StatusConflict, err.Error())
+		return
+	}
+	writeJSON(w, http.StatusOK, p)
+}
