+func canonicalObjectOr(raw json.RawMessage, fallback string) (json.RawMessage, error) {
+	if len(raw) == 0 {
+		raw = json.RawMessage(fallback)
+	}
+	var v any
+	if err := json.Unmarshal(raw, &v); err != nil {
+		return nil, err
+	}
+	b, err := json.Marshal(v)
+	if err != nil {
+		return nil, err
+	}
+	return json.RawMessage(b), nil
+}
