<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef ProductName ?>
    <?define ProductName = "DigiLogic OnePane Alpha 3.3 RC10" ?>
  <?endif ?>
  <?ifndef ProductVersion ?>
    <?error Missing ProductVersion. Pass -d ProductVersion=x.y.z. Refusing a stale hard-coded MSI version. ?>
  <?endif ?>
  <Package Name="$(var.ProductName)" Manufacturer="DigiLogic" Version="$(var.ProductVersion)"
           UpgradeCode="9F7D57AE-B2C4-44E2-96E4-F09E145AE235" Scope="perMachine" Language="1033">
    <SummaryInformation Description="DigiLogic OnePane native Windows desktop application" Manufacturer="DigiLogic" />
    <MajorUpgrade DowngradeErrorMessage="A newer OnePane MSI is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="OnePaneProductIcon" SourceFile="$(var.PayloadDir)\OnePane.ico"/>
    <Property Id="ARPPRODUCTICON" Value="OnePaneProductIcon"/>
    <!-- Public secure MSI properties support unattended enterprise installs.
         GUI installation offers the same Data root and storage paths. -->
    <Property Id="ONEPANE_DATA_ROOT" Secure="yes">
      <RegistrySearch Id="ExistingOnePaneDataRoot" Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="DataRoot" Type="raw"/>
    </Property>
    <Property Id="ONEPANE_MODEL_ROOT" Secure="yes">
      <RegistrySearch Id="ExistingOnePaneModelRoot" Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="ModelRoot" Type="raw"/>
    </Property>
    <Property Id="ONEPANE_PROJECT_ROOT" Secure="yes">
      <RegistrySearch Id="ExistingOnePaneProjectRoot" Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="ProjectRoot" Type="raw"/>
    </Property>
    <!-- Copies of the installed roots. The editable properties above can be
         changed in the wizard; these cannot, so an upgrade can be refused
         instead of recording a different directory. -->
    <Property Id="ONEPANE_INSTALLED_DATA_ROOT" Secure="yes">
      <RegistrySearch Id="RecordedOnePaneDataRoot" Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="DataRoot" Type="raw"/>
    </Property>
    <Property Id="ONEPANE_INSTALLED_MODEL_ROOT" Secure="yes">
      <RegistrySearch Id="RecordedOnePaneModelRoot" Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="ModelRoot" Type="raw"/>
    </Property>
    <Property Id="ONEPANE_INSTALLED_PROJECT_ROOT" Secure="yes">
      <RegistrySearch Id="RecordedOnePaneProjectRoot" Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="ProjectRoot" Type="raw"/>
    </Property>
    <!-- The legacy EXE installer owns its own service registration. Removing it
         with data preservation is required before switching to Windows Installer. -->
    <Property Id="ONEPANE_LEGACY_EXE">
      <RegistrySearch Id="ExistingLegacyExeInstall" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\OnePane" Name="DisplayVersion" Type="raw"/>
    </Property>
    <Launch Condition="NOT ONEPANE_LEGACY_EXE" Message="An earlier OnePane EXE installation is present. Uninstall that version first (preserve its data), then run the native MSI." />
    <SetProperty Id="ONEPANE_DATA_ROOT" Value="[CommonAppDataFolder]OnePane" Before="CostFinalize"
                 Sequence="both" Condition="NOT ONEPANE_DATA_ROOT"/>
    <!-- Fresh installs do not invent model or project folders under ProgramData.
         An upgrade that recorded only DataRoot keeps the historical derived
         folders. A recorded model or project root is never replaced here. -->
    <SetProperty Id="ONEPANE_MODEL_ROOT" Value="[ONEPANE_DATA_ROOT]\models" Before="CostFinalize"
                 Sequence="both" Condition="NOT ONEPANE_MODEL_ROOT AND ONEPANE_INSTALLED_DATA_ROOT"/>
    <SetProperty Id="ONEPANE_PROJECT_ROOT" Value="[ONEPANE_DATA_ROOT]\Projects" Before="CostFinalize"
                 Sequence="both" Condition="NOT ONEPANE_PROJECT_ROOT AND ONEPANE_INSTALLED_DATA_ROOT"/>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="DigiLogicFolder" Name="DigiLogic">
        <Directory Id="INSTALLFOLDER" Name="OnePane"/>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DigiLogicMenu" Name="DigiLogic"/>
    </StandardDirectory>
    <ComponentGroup Id="OnePanePayload" Directory="INSTALLFOLDER">
      <Component Id="OnePaneService" Guid="4F8A237D-ECD6-488F-8589-96C0609DA358">
        <File Id="OnePaneServiceExe" Source="$(var.PayloadDir)\OnePane.Service.exe" KeyPath="yes"/>
        <ServiceInstall Id="OnePaneServiceInstall" Name="OnePane" DisplayName="OnePane" Description="DigiLogic OnePane local-first AI control plane"
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem"/>
        <ServiceControl Id="OnePaneServiceControl" Name="OnePane" Start="install" Stop="both" Remove="uninstall" Wait="yes"/>
      </Component>
      <Component Id="OnePaneBackend" Guid="AE1B138F-2FF7-474A-89A3-0D67536F5879">
        <File Id="OnePaneBackendExe" Source="$(var.PayloadDir)\OnePane.Backend.exe" KeyPath="yes"/>
      </Component>
      <Component Id="OnePaneDesktop" Guid="7E322D0B-6E92-4148-A542-75A2ABDC403F">
        <File Id="OnePaneDesktopExe" Source="$(var.PayloadDir)\OnePane.Desktop.exe" KeyPath="yes"/>
      </Component>
      <Component Id="OnePaneIconComponent" Guid="598F4D95-7A91-472B-8920-78E8DF6E0A7E">
        <File Id="OnePaneIconFile" Source="$(var.PayloadDir)\OnePane.ico" KeyPath="yes"/>
      </Component>
      <Component Id="OnePanePreflight" Guid="B7E4A1C2-6D58-4F0E-9A33-1C5E8F2A4D70">
        <File Id="OnePanePreflightExe" Source="$(var.PayloadDir)\OnePane.Preflight.exe" KeyPath="yes"/>
      </Component>
      <Component Id="OnePaneRegistry" Guid="2E29C90F-BB96-4542-B894-5EB4DA095190">
        <RegistryValue Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="DataRoot" Type="string" Value="[ONEPANE_DATA_ROOT]" KeyPath="yes"/>
        <RegistryValue Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="ModelRoot" Type="string" Value="[ONEPANE_MODEL_ROOT]"/>
        <RegistryValue Root="HKLM" Key="SOFTWARE\DigiLogic\OnePane" Name="ProjectRoot" Type="string" Value="[ONEPANE_PROJECT_ROOT]"/>
      </Component>
    </ComponentGroup>
    <ComponentGroup Id="OnePaneShortcuts" Directory="DigiLogicMenu">
      <Component Id="OnePaneStartMenu" Guid="A6CCAB99-4E30-4194-8BA3-7E0476CFAC34">
        <Shortcut Id="OnePaneStartShortcut" Name="OnePane" Description="DigiLogic OnePane" Target="[#OnePaneDesktopExe]"
                  WorkingDirectory="INSTALLFOLDER" Icon="OnePaneProductIcon"/>
        <RemoveFolder Id="OnePaneMenuRemove" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\DigiLogic\OnePane" Name="StartMenu" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </ComponentGroup>
    <Feature Id="OnePaneFeature" Title="DigiLogic OnePane" Level="1" Display="expand" AllowAdvertise="no">
      <ComponentGroupRef Id="OnePanePayload"/>
      <ComponentGroupRef Id="OnePaneShortcuts"/>
    </Feature>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>
    <!-- A second wizard page exposes the data/model/project roots before installation. -->
    <UI>
      <Dialog Id="OnePaneStorageDlg" Width="370" Height="300" Title="OnePane - Data Locations">
        <Control Id="Title" Type="Text" X="20" Y="16" Width="330" Height="21" Transparent="yes" NoPrefix="yes"
                 Text="Choose OnePane storage locations"/>
        <Control Id="Help" Type="Text" X="20" Y="40" Width="330" Height="48"
                 Text="Program data defaults to C:\ProgramData\OnePane. Choose local NTFS folders for models and projects. An upgrade keeps existing folders. An incomplete folder, including an empty node.identity, is left unchanged: choose a different data directory or cancel."/>
        <Control Id="DataLabel" Type="Text" X="20" Y="96" Width="325" Height="14" Text="Application data directory (runtimes, logs, caches, database):"/>
        <Control Id="DataInput" Type="Edit" X="20" Y="110" Width="325" Height="18" Property="ONEPANE_DATA_ROOT"/>
        <Control Id="ModelsLabel" Type="Text" X="20" Y="138" Width="325" Height="14" Text="Model weights directory:"/>
        <Control Id="ModelsInput" Type="Edit" X="20" Y="152" Width="325" Height="18" Property="ONEPANE_MODEL_ROOT"/>
        <Control Id="ProjectsLabel" Type="Text" X="20" Y="180" Width="325" Height="14" Text="Project directory:"/>
        <Control Id="ProjectsInput" Type="Edit" X="20" Y="194" Width="325" Height="18" Property="ONEPANE_PROJECT_ROOT"/>
        <Control Id="Back" Type="PushButton" X="182" Y="273" Width="56" Height="17" Text="&lt; Back">
          <Publish Event="NewDialog" Value="InstallDirDlg"/>
        </Control>
        <Control Id="Next" Type="PushButton" X="242" Y="273" Width="56" Height="17" Default="yes" Text="Next &gt;">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="ONEPANE_DATA_ROOT AND ONEPANE_MODEL_ROOT AND ONEPANE_PROJECT_ROOT"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="273" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg"/>
        </Control>
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OnePaneStorageDlg" Order="5" Condition="NOT Installed"/>
    </UI>
    <!-- Read-only NTFS, free-space, upgrade, and partial-root check. It runs
         after the preflight executable is copied and before the service starts,
         and it does not modify the selected roots. -->
    <SetProperty Id="OnePaneStorageCheck" Before="OnePaneStorageCheck" Sequence="execute"
                 Value="&quot;[#OnePanePreflightExe]&quot; -data &quot;[ONEPANE_DATA_ROOT]&quot; -model &quot;[ONEPANE_MODEL_ROOT]&quot; -project &quot;[ONEPANE_PROJECT_ROOT]&quot; -installed-data &quot;[ONEPANE_INSTALLED_DATA_ROOT]&quot; -installed-model &quot;[ONEPANE_INSTALLED_MODEL_ROOT]&quot; -installed-project &quot;[ONEPANE_INSTALLED_PROJECT_ROOT]&quot; -program-data &quot;[CommonAppDataFolder]&quot; -program-volume &quot;[ProgramFiles64Folder]&quot; -ui-level [UILevel]"/>
    <CustomAction Id="OnePaneStorageCheck" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check"/>
    <InstallExecuteSequence>
      <Custom Action="OnePaneStorageCheck" After="InstallFiles">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Package>
</Wix>
